{
  "name": "@ao/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "db:generate": "node --env-file=../../.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=../../.env.local src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ao/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.4",
    "@fastify/websocket": "^11.0.1",
    "@sentry/node": "^10.63.0",
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.2.1",
    "msgpackr": "^1.11.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.15.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
