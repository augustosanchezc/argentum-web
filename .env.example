# Plantilla de variables de entorno para desarrollo local.
# Copialo a .env.local y ajusta lo que necesites. .env.local esta en .gitignore.

# PostgreSQL (Docker Compose)
POSTGRES_DB=argentum
POSTGRES_USER=argentum
POSTGRES_PASSWORD=argentum_dev
POSTGRES_PORT=5432

# Redis (Docker Compose)
REDIS_PORT=6379

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT (cambiar en produccion)
JWT_SECRET=cambiar_en_produccion_alcanza_para_dev_local
JWT_TTL_SECONDS=86400

# Conexion a Postgres
# Composicion derivada: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgres://argentum:argentum_dev@localhost:5432/argentum

# Bcrypt
BCRYPT_ROUNDS=12
