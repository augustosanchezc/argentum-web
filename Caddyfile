# Caddyfile de producción para AO Web MMORPG.
# Caddy gestiona TLS automáticamente con Let's Encrypt.
# {$DOMAIN} se toma de .env.prod. Asume Cloudflare como proxy delante.

{$DOMAIN} {
    encode zstd gzip

    # Headers de seguridad.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # /metrics NUNCA se expone al exterior. Prometheus lo scrapea por la red
    # interna de Docker (ao-server:3000/metrics), no vía Caddy.
    respond /metrics 403

    # ── API + WebSocket del servidor de juego ─────────────────────────────────
    # Rutas REALES del server (no /api/*): auth, characters, admin, ws, health,
    # maps, item-overrides. El resto (cliente/assets) lo sirve Caddy estático.
    @backend path /auth/* /characters /characters/* /admin /admin/* /ws /health /maps /item-overrides
    handle @backend {
        reverse_proxy ao-server:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            # IP real del cliente para el rate-limit y la allowlist del panel.
            # Detrás de Cloudflare, la IP verdadera viene en CF-Connecting-IP;
            # se propaga como X-Forwarded-For (Fastify trustProxy la lee).
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }

    # ── Grafana (protegido por su propia contraseña) ──────────────────────────
    handle_path /grafana/* {
        reverse_proxy grafana:3000
    }

    # ── Cliente estático (build de Vite) + assets del AO (dist/ao-assets) ──────
    # SPA fallback: cualquier ruta desconocida devuelve index.html.
    handle {
        root * /srv/client
        try_files {path} /index.html
        file_server
        # index.html sin cache (deploys nuevos se ven al instante); assets con
        # hash en el nombre → cache agresivo.
        header /index.html Cache-Control "no-store"
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
    }
}
