# Dependencias
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Vite cache
.vite/
packages/*/dist/
packages/*/.vite/

# Variables de entorno
.env
.env.local
.env.*.local
!.env.example
.env.prod
!.env.prod.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Coverage
coverage/
.nyc_output/

# Docker volumes locales (datos persistentes de Postgres/Redis en dev)
data/
.docker-data/

# Excepcion: assets de mapas del juego (de ao-libre, AGPL-3.0) — sin estos
# el server no arranca, asi que viajan con el repo.
!packages/server/data/
!packages/server/data/**

# Archivos temporales del proyecto
*.tmp
*.bak
.cache/

# Insumo del script fetch-ulla-assets (se baja aparte, no es asset de runtime).
# El cliente solo necesita graficos.json + los PNGs, que si viajan con el repo.
packages/client/public/ao-assets/Graficos.ind

# Claude Code (mantener agentes y memorias compartidas; ignorar transitorios)
.claude/sessions/
.claude/logs/
.claude/settings.local.json
