# ── Dominio ──────────────────────────────────────────────────────────────────
# Caddy usa esta variable para el certificado TLS y el routing.
DOMAIN=mmo.example.com

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=ao
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=ao_prod
# El servidor lee DATABASE_URL directamente (REQUERIDO). En docker-compose se
# arma con los valores de arriba apuntando al servicio `postgres`.
DATABASE_URL=postgres://ao:cambia-esta-contrasena@postgres:5432/ao_prod

# ── Redis ────────────────────────────────────────────────────────────────────
# Reservado para escalado futuro (pub/sub entre nodos). HOY NO está cableado en
# el código — el mundo vive en RAM de una sola instancia.
REDIS_URL=redis://redis:6379

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# OJO: el código lee SERVER_HOST / SERVER_PORT (no HOST / PORT).
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info

# JWT / sesiones — generá uno nuevo con: openssl rand -base64 48
JWT_SECRET=genera-un-secreto-de-al-menos-32-chars-aqui
JWT_TTL_SECONDS=86400
BCRYPT_ROUNDS=12

# ── Administración ────────────────────────────────────────────────────────────
# Email que se promueve a Dios (rol 3) al arrancar (debe registrarse primero).
ADMIN_EMAIL=admin@example.com
# Allowlist de IPs para el panel /admin (coma-separadas). Vacío = sin restricción.
# En prod poné tu IP; Caddy además filtra por IP delante.
ADMIN_IP_ALLOWLIST=

# ── Captcha (Cloudflare Turnstile) ────────────────────────────────────────────
# Secret del widget (server). Vacío = captcha desactivado.
TURNSTILE_SECRET=
# Site key del widget (cliente, build-time). Se pasa como VITE_TURNSTILE_SITEKEY
# al buildear el cliente. Vacío = no se muestra el captcha.
VITE_TURNSTILE_SITEKEY=

# ── Assets por CDN (opcional) ─────────────────────────────────────────────────
# URL base de los assets si los servís desde Cloudflare R2/CDN (build-time).
# Vacío = se sirven desde el mismo origen (/ao-assets).
VITE_ASSETS_BASE=

# ── Observabilidad ────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=cambia-esta-contrasena-grafana
# Sentry (opcional — dejar vacío para deshabilitar)
SENTRY_DSN=
VITE_SENTRY_DSN=
