# ── Dominio ──────────────────────────────────────────────────────────────────
# Caddy usa esta variable para el certificado TLS y el routing.
DOMAIN=mmo.example.com

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=ao
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=ao_prod

# ── Redis ────────────────────────────────────────────────────────────────────
# La URL completa se arma en docker-compose.prod.yml usando los valores de arriba.
# Solo necesaria si corrés el servidor fuera de Docker.
REDIS_URL=redis://redis:6379

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# JWT / sesiones
JWT_SECRET=genera-un-secreto-de-al-menos-32-chars-aqui

# ── Observabilidad ────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=cambia-esta-contrasena-grafana

# Sentry (opcional — dejar vacío para deshabilitar)
SENTRY_DSN=
